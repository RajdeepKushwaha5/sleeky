# Discord user ID for Lanyard live status (must be a member of the Lanyard Discord server: https://discord.gg/lanyard)
# Exposed to the browser, so it must be prefixed with NEXT_PUBLIC_
NEXT_PUBLIC_DISCORD_USER_ID=

# Medium RSS feed URL for auto-fetching the latest blog posts (ISR, revalidated hourly).
# Defaults to https://rajdeep01.medium.com/feed when unset.
MEDIUM_FEED_URL=
